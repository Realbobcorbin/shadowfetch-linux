[Desktop Entry]
Type=Application
Name=UXTerm
GenericName=Terminal emulator
Comment=XTerm wrapper with Unicode support
Exec=uxterm
TryExec=uxterm
Icon=xterm-color_48x48
Terminal=false
Categories=System;TerminalEmulator;
# Shadowfetch launcher cleanup: Konsole is the terminal.  uxterm stays
# installed; this override only removes the duplicate menu entry.
NoDisplay=true
Keywords=shell;prompt;command;commandline;cmd;unicode;
