[Desktop Entry]
Type=Application
Name=XTerm
GenericName=Terminal emulator
Comment=Standard terminal emulator for the X Window System
Exec=xterm
TryExec=xterm
Icon=mini.xterm_48x48
Terminal=false
Categories=System;TerminalEmulator;
# Shadowfetch launcher cleanup: Konsole is the terminal.  This covers the
# Debian-prefixed desktop-file id of the same entry.
NoDisplay=true
Keywords=shell;prompt;command;commandline;cmd;
