#!/bin/bash
set -euo pipefail

# ---- --help / --version, BEFORE any side effect -----------------------------
# This block is deliberately the first thing that runs. Until 2026-07-26 this
# tool had no argument handling at all, so `--help` fell through to the body and
# ran the tool's normal actions. Someone asking a command what it does
# should never thereby cause it to do the thing.
case "${1:-}" in
  -h|--help)
    cat <<'SFHELP'
shadowfetch-browser-import - Import bookmarks and passwords into a sandboxed browser.

USAGE
  shadowfetch-browser-import   guided import

WHAT IT DOES
  Uses ~/Browser Import as a temporary 0700 staging directory and REMOVES
  IT when finished. Grants the browser read-only access for the transfer
  only, then revokes it.

Part of Shadowfetch Linux. https://www.shadowfetchlinux.org/
SFHELP
    exit 0 ;;
  --version)
    echo "shadowfetch-browser-import (Shadowfetch Linux) $(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)"; exit 0 ;;
esac

IMPORT_DIR="$HOME/Browser Import"
APP_ID="com.brave.Browser"

say() { printf '\033[1;33m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }

choose_file() {
    local title=$1 filter=$2 selected
    if command -v kdialog >/dev/null 2>&1 && { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        selected=$(kdialog --title "$title" --getopenfilename "$HOME" "$filter" 2>/dev/null || true)
    else
        read -r -p "$title - enter the full file path: " selected
    fi
    [ -n "${selected:-}" ] && [ -f "$selected" ] || return 1
    printf '%s\n' "$selected"
}

allow_flatpak_imports() {
    if command -v flatpak >/dev/null 2>&1 && flatpak info "$APP_ID" >/dev/null 2>&1; then
        flatpak override --user --filesystem="$IMPORT_DIR:ro" "$APP_ID"
        info "Temporary read-only browser access enabled for: $IMPORT_DIR"
    fi
}

stage_bookmarks() {
    local source target
    source=$(choose_file "Choose a bookmark HTML export" "*.html *.htm") || { info "No file selected."; return; }
    mkdir -p "$IMPORT_DIR"
    chmod 700 "$IMPORT_DIR"
    target="$IMPORT_DIR/bookmarks.html"
    install -m 600 "$source" "$target"
    if grep -Eiq '<(DT>)?<A[[:space:]][^>]*HREF=' "$target"; then
        info "Bookmark export is readable and contains bookmark links."
    else
        rm -f "$target"
        info "That file does not look like a browser bookmark HTML export."
        return 1
    fi
    allow_flatpak_imports
    info "Ready to import: $target"
}

stage_passwords() {
    local source target
    source=$(choose_file "Choose a password CSV export" "*.csv") || { info "No file selected."; return; }
    mkdir -p "$IMPORT_DIR"
    chmod 700 "$IMPORT_DIR"
    target="$IMPORT_DIR/passwords.csv"
    install -m 600 "$source" "$target"
    if ! python3 - "$target" <<'PY'
import csv
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8-sig", newline="") as handle:
    sample = handle.read(8192)
    handle.seek(0)
    try:
        dialect = csv.Sniffer().sniff(sample, delimiters=",;\t")
    except csv.Error:
        dialect = csv.excel
    reader = csv.reader(handle, dialect)
    header = {value.strip().lower() for value in next(reader, [])}
required = {"url", "username", "password"}
if not required.issubset(header):
    print("Expected CSV columns: url, username, password", file=sys.stderr)
    raise SystemExit(1)
PY
    then
        rm -f "$target"
        info "The CSV header is not in a browser-compatible password format."
        return 1
    fi
    allow_flatpak_imports
    info "Password export is readable and has the expected columns."
    info "Ready to import: $target"
    info "Delete this plaintext credential file as soon as import succeeds."
}

open_browser_page() {
    local page=$1
    allow_flatpak_imports
    if command -v flatpak >/dev/null 2>&1 && flatpak info "$APP_ID" >/dev/null 2>&1; then
        flatpak run "$APP_ID" "$page" >/dev/null 2>&1 &
    elif command -v brave-browser >/dev/null 2>&1; then
        brave-browser "$page" >/dev/null 2>&1 &
    elif command -v chromium >/dev/null 2>&1; then
        chromium "${page/brave:/chrome:}" >/dev/null 2>&1 &
    else
        info "No supported Chromium-family browser was detected."
        return 1
    fi
}

cleanup() {
    rm -rf "$IMPORT_DIR"
    if command -v flatpak >/dev/null 2>&1 && flatpak info "$APP_ID" >/dev/null 2>&1; then
        flatpak override --user --nofilesystem="$IMPORT_DIR" "$APP_ID" 2>/dev/null || true
    fi
    info "Staged imports removed and temporary folder access revoked."
}

say "Shadowfetch Browser Migration"
info "Copies exports into one private folder, validates their format, and grants"
info "an installed Flatpak browser read-only access only to that folder."
printf '\n  1) Prepare bookmark HTML\n  2) Prepare password CSV\n  3) Open bookmark manager\n  4) Open password import settings\n  5) Remove staged files and revoke access\n  q) Quit\n\n'
read -r -p "Choose: " choice
case "$choice" in
    1) stage_bookmarks ;;
    2) stage_passwords ;;
    3) open_browser_page "brave://bookmarks/" ;;
    4) open_browser_page "brave://password-manager/settings" ;;
    5) cleanup ;;
    q|Q|"") exit 0 ;;
    *) exit 1 ;;
esac
