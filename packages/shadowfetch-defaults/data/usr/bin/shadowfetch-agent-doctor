#!/bin/bash
# Buzz relay and shared-compute health/privacy audit. Fixes are opt-in.
set -uo pipefail

FIX=0
case "${1:-}" in
  -h|--help)
    cat <<'EOF'
shadowfetch-agent-doctor - Read-only local AI health and privacy audit.

USAGE
  shadowfetch-agent-doctor
  shadowfetch-agent-doctor --fix-permissions

The fix option only restricts Shadowfetch Buzz configuration to the owner.
EOF
    exit 0 ;;
  --version)
    echo "shadowfetch-agent-doctor (Shadowfetch Linux) $(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)"; exit 0 ;;
  --fix-permissions) FIX=1 ;;
  "") ;;
  *) echo "Unknown option: $1" >&2; exit 2 ;;
esac

warnings=0
ok() { printf '  \033[1;32mOK\033[0m  %s\n' "$*"; }
warn() { printf '  \033[1;31m!!\033[0m  %s\n' "$*"; warnings=$((warnings + 1)); }
info() { printf '  --  %s\n' "$*"; }

printf 'Shadowfetch Local AI Health & Security\n%s\n' '======================================='

for tool in buzz-desktop buzz-agent podman podman-compose git rg; do
    if command -v "$tool" >/dev/null 2>&1; then
        ok "$tool is installed"
    else
        info "$tool is not installed"
    fi
done

listeners=$(ss -ltnH 2>/dev/null | awk '{print $4}' || true)
for port in 3000 9337; do
    if printf '%s\n' "$listeners" | grep -E "(^|[^:])0\\.0\\.0\\.0:${port}$|\\[::\\]:${port}$" >/dev/null; then
        warn "Port $port is listening on every interface; local AI should be loopback-only."
    elif printf '%s\n' "$listeners" | grep -E "127\\.0\\.0\\.1:${port}$|\\[::1\\]:${port}$" >/dev/null; then
        ok "Port $port is loopback-only."
    else
        info "Port $port is closed."
    fi
done

for file in "$HOME/.config/shadowfetch/buzz/client.env" \
            "$HOME/.local/share/shadowfetch/buzz/.env"; do
    [[ -f "$file" ]] || continue
    mode=$(stat -c '%a' "$file" 2>/dev/null || echo 600)
    if (( 10#$mode % 100 != 0 )); then
        if (( FIX )); then
            chmod 600 "$file" && ok "Restricted $file to owner-only access."
        else
            warn "$file is readable by another local user."
        fi
    else
        ok "$file is owner-private."
    fi
done

if command -v shadowfetch-buzz >/dev/null 2>&1; then
    if curl -fsS --max-time 3 http://127.0.0.1:3000/_readiness >/dev/null 2>&1; then
        ok "Buzz relay readiness check passed."
    else
        info "Buzz relay is stopped or still starting."
    fi
fi
if curl -fsS --max-time 3 http://127.0.0.1:9337/v1/models >/dev/null 2>&1; then
    ok "Buzz shared-compute model endpoint is ready."
else
    info "Buzz shared compute is off; model downloads are managed inside Buzz."
fi

printf '\n%d warning(s).\n' "$warnings"
(( warnings == 0 ))
