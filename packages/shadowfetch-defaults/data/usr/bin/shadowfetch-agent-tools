#!/bin/bash
# Guided Buzz, relay and sandbox tools for Fire Edition.
set -euo pipefail

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
shadowfetch-agent-tools - Buzz shared-compute and container tools.

USAGE
  shadowfetch-agent-tools
  shadowfetch-agent-tools --doctor
EOF
    exit 0 ;;
  --version)
    echo "shadowfetch-agent-tools (Shadowfetch Linux) $(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)"; exit 0 ;;
  --doctor) exec shadowfetch-agent-doctor ;;
  "") ;;
  *) echo "Unknown option: $1" >&2; exit 2 ;;
esac

say() { printf '\n\033[1;33m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }

sandbox_check() {
    say "Container sandbox readiness"
    if command -v podman >/dev/null 2>&1; then
        podman info --format 'Podman {{.Version.Version}} - rootless={{.Host.Security.Rootless}}'
        info "The Buzz relay runs as this user and publishes only 127.0.0.1:3000."
    else
        info "Podman is missing. Install it with: sudo apt install podman podman-compose"
    fi
}

say "Shadowfetch Local AI Tools"
printf '\n  1) Set up or update Buzz\n  2) Open Buzz\n  3) Show Buzz and shared-compute status\n  4) Check container sandbox readiness\n  5) Run local AI health and security audit\n  q) Quit\n\n'
read -r -p "Choose: " choice
case "$choice" in
    1) exec shadowfetch-buzz setup ;;
    2) exec shadowfetch-buzz open ;;
    3) exec shadowfetch-buzz status ;;
    4) sandbox_check ;;
    5) shadowfetch-agent-doctor ;;
    q|Q|"") exit 0 ;;
    *) info "Unknown choice."; exit 1 ;;
esac
