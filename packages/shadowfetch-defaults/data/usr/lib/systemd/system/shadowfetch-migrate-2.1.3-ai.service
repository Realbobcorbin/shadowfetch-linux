[Unit]
Description=Complete the Shadowfetch 2.1.3 local AI package migration
Documentation=https://www.shadowfetchlinux.org/upgrade
ConditionPathExists=/var/lib/shadowfetch/migrations/2.1.3-ai.pending
After=local-fs.target apt-daily.service apt-daily-upgrade.service packagekit.service

[Service]
Type=oneshot
ExecCondition=/usr/libexec/shadowfetch-migrate-2.1.3-ai --ready
ExecStart=/usr/libexec/shadowfetch-migrate-2.1.3-ai
SuccessExitStatus=75
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=yes
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
