[Unit]
Description=Shadowfetch local Buzz relay
Documentation=https://github.com/block/buzz
Wants=network-online.target
After=network-online.target
# Setup writes this private file only after the user explicitly chooses Buzz.
ConditionPathExists=%h/.local/share/shadowfetch/buzz/.env

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/.local/share/shadowfetch/buzz
ExecStart=/usr/libexec/shadowfetch-buzz-stack start
ExecStop=/usr/libexec/shadowfetch-buzz-stack stop
TimeoutStartSec=1800
TimeoutStopSec=120

[Install]
WantedBy=default.target
