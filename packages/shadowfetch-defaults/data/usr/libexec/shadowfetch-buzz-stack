#!/bin/bash
# Start Buzz's backing services in a Podman-compatible, verified order.
set -euo pipefail

PROJECT="${SHADOWFETCH_BUZZ_PROJECT:-shadowfetch-buzz}"
COMPOSE_FILE="${SHADOWFETCH_BUZZ_COMPOSE_FILE:-compose.yml}"
ENV_FILE="${SHADOWFETCH_BUZZ_ENV_FILE:-.env}"
started_here=0

[[ "$PROJECT" =~ ^[A-Za-z0-9_.-]+$ ]] || {
    echo "Invalid Buzz project name: $PROJECT" >&2
    exit 2
}
[[ -r "$COMPOSE_FILE" && -r "$ENV_FILE" ]] || {
    echo "Buzz configuration is incomplete in $PWD; rerun shadowfetch-buzz setup." >&2
    exit 2
}
[[ $(stat -c '%a' "$ENV_FILE") == 600 ]] || {
    echo "Buzz secret file must have mode 600: $ENV_FILE" >&2
    exit 2
}

lock_dir=${XDG_RUNTIME_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/shadowfetch}
install -d -m 0700 "$lock_dir"
lock_file="$lock_dir/shadowfetch-buzz-stack.lock"
if [[ ${1:-} != --shadowfetch-lock-held ]]; then
    rc=0
    flock -n -E 75 -o "$lock_file" "$0" --shadowfetch-lock-held \
        "${1:-start}" || rc=$?
    if (( rc == 75 )); then
        echo "A Buzz stack operation is already running." >&2
        exit 3
    fi
    exit "$rc"
fi
shift

compose=(podman-compose -p "$PROJECT" -f "$COMPOSE_FILE")

container_name() {
    printf '%s_%s_1\n' "$PROJECT" "$1"
}

relay_port() {
    local port
    port=$(awk -F= '$1 == "BUZZ_HTTP_PORT" {print $2; exit}' "$ENV_FILE" 2>/dev/null || true)
    if [[ ! "$port" =~ ^[0-9]+$ ]] || (( port < 1024 || port > 65535 )); then
        echo "BUZZ_HTTP_PORT must be an integer from 1024 through 65535." >&2
        return 1
    fi
    printf '%s\n' "$port"
}

relay_ready() {
    local port
    port=$(relay_port)
    curl -fsS --max-time 2 "http://127.0.0.1:${port}/_readiness" >/dev/null 2>&1
}

port_in_use() {
    local port=$1
    ss -H -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)$port$"
}

wait_in_container() {
    local service=$1 description=$2
    shift 2
    local container
    container=$(container_name "$service")
    for _ in $(seq 1 90); do
        if podman exec "$container" "$@" >/dev/null 2>&1; then
            return 0
        fi
        sleep 2
    done
    echo "Timed out waiting for $description." >&2
    podman logs --tail 100 "$container" >&2 || true
    return 1
}

cleanup_failed_start() {
    rc=$?
    if (( rc != 0 && started_here )); then
        echo "Buzz startup failed; stopping partial containers while preserving data volumes." >&2
        "${compose[@]}" stop >/dev/null 2>&1 || true
    fi
    exit "$rc"
}

start_stack() {
    local port free
    if relay_ready; then
        printf 'Buzz relay already ready on 127.0.0.1:%s.\n' "$(relay_port)"
        return 0
    fi
    port=$(relay_port)
    if port_in_use "$port"; then
        echo "Port $port is occupied by another process; Buzz was not started." >&2
        return 1
    fi
    free=$(df -PB1 "$HOME" | awk 'NR == 2 {print $4}')
    if [[ ! "$free" =~ ^[0-9]+$ ]] || (( free < 8 * 1024 * 1024 * 1024 )); then
        echo "Buzz needs at least 8 GiB of free space for images and service data." >&2
        return 1
    fi
    podman info >/dev/null
    "${compose[@]}" config >/dev/null
    echo "Pulling release-pinned Buzz service images..."
    "${compose[@]}" pull

    trap cleanup_failed_start EXIT
    started_here=1
    "${compose[@]}" up -d postgres redis minio
    # These variables expand inside their containers from Compose-provided env.
    # shellcheck disable=SC2016
    wait_in_container postgres PostgreSQL sh -ec 'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"'
    # shellcheck disable=SC2016
    wait_in_container redis Redis sh -ec 'redis-cli -a "$REDIS_PASSWORD" ping | grep -q PONG'
    wait_in_container minio MinIO curl -fsS http://127.0.0.1:9000/minio/health/live

    "${compose[@]}" run --rm minio-init
    "${compose[@]}" up -d relay

    for _ in $(seq 1 90); do
        if relay_ready; then
            printf 'Buzz relay ready on 127.0.0.1:%s.\n' "$port"
            started_here=0
            trap - EXIT
            return 0
        fi
        sleep 2
    done
    echo "Buzz relay failed its readiness probe." >&2
    podman logs --tail 160 "$(container_name relay)" >&2 || true
    return 1
}

case "${1:-start}" in
    start) start_stack ;;
    stop) "${compose[@]}" stop ;;
    *) echo "Usage: shadowfetch-buzz-stack {start|stop}" >&2; exit 2 ;;
esac
