#!/bin/bash
# Enrol the first local Buzz profile without weakening relay authorization.
set -euo pipefail

PROJECT="${SHADOWFETCH_BUZZ_PROJECT:-shadowfetch-buzz}"
COMMUNITY_HOST="${SHADOWFETCH_BUZZ_COMMUNITY_HOST:-127.0.0.1:3000}"
STATE_DIR="${SHADOWFETCH_BUZZ_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/shadowfetch/buzz}"
ATTEMPTS="${SHADOWFETCH_BUZZ_BOOTSTRAP_ATTEMPTS:-600}"
INTERVAL="${SHADOWFETCH_BUZZ_BOOTSTRAP_INTERVAL:-3}"
MARKER="$STATE_DIR/local-owner-enrolled"

warn() { printf 'Buzz owner bootstrap: %s\n' "$*" >&2; }

usage() {
    cat <<'EOF'
shadowfetch-buzz-bootstrap - Enrol the first owner of a private local Buzz relay.

USAGE
  shadowfetch-buzz-bootstrap

The helper acts only when the loopback relay has no members and exactly one
profile has authored Buzz's initial channel-creation event. It never reads a
profile secret or replaces an existing relay roster.
EOF
}

container_for() {
    local service=$1 output line
    local -a containers=()
    output=$(podman ps \
        --filter "label=com.docker.compose.project=$PROJECT" \
        --filter "label=com.docker.compose.service=$service" \
        --format '{{.Names}}') || return 1
    while IFS= read -r line; do
        [[ -n "$line" ]] && containers+=("$line")
    done <<< "$output"
    ((${#containers[@]} == 1)) || return 1
    printf '%s\n' "${containers[0]}"
}

db_query() {
    local postgres=$1 sql=$2
    podman exec -u postgres "$postgres" \
        psql -X -qAt -v ON_ERROR_STOP=1 -U buzz -d buzz -c "$sql"
}

mark_complete() {
    local temporary="$MARKER.tmp.$$"
    printf 'local relay owner enrolled\n' > "$temporary"
    chmod 0600 "$temporary"
    mv -f "$temporary" "$MARKER"
}

notify_complete() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send --app-name="Shadowfetch Buzz" \
        "Buzz local owner ready" \
        "The private relay roster is ready for shared compute." >/dev/null 2>&1 || true
}

bootstrap_owner() {
    local attempt relay postgres member_count candidate_output candidate
    local -a candidates=()
    local member_sql candidate_sql

    member_sql="SELECT count(*) FROM relay_members m JOIN communities c ON c.id=m.community_id WHERE c.host='$COMMUNITY_HOST';"
    candidate_sql="SELECT DISTINCT encode(e.pubkey,'hex') FROM events e JOIN communities c ON c.id=e.community_id WHERE c.host='$COMMUNITY_HOST' AND e.kind=9007 ORDER BY 1;"

    for ((attempt = 1; attempt <= ATTEMPTS; attempt += 1)); do
        relay=$(container_for relay 2>/dev/null) || { sleep "$INTERVAL"; continue; }
        postgres=$(container_for postgres 2>/dev/null) || { sleep "$INTERVAL"; continue; }
        member_count=$(db_query "$postgres" "$member_sql" 2>/dev/null) || {
            sleep "$INTERVAL"
            continue
        }
        [[ "$member_count" =~ ^[0-9]+$ ]] || {
            warn "relay returned an invalid membership count; refusing to act"
            return 4
        }
        if ((member_count > 0)); then
            mark_complete
            return 0
        fi

        candidate_output=$(db_query "$postgres" "$candidate_sql" 2>/dev/null) || {
            sleep "$INTERVAL"
            continue
        }
        candidates=()
        while IFS= read -r candidate; do
            [[ -n "$candidate" ]] && candidates+=("$candidate")
        done <<< "$candidate_output"

        if ((${#candidates[@]} == 0)); then
            sleep "$INTERVAL"
            continue
        fi
        if ((${#candidates[@]} != 1)); then
            warn "multiple first-owner candidates found; refusing to change the roster"
            return 4
        fi
        candidate=${candidates[0]}
        [[ "$candidate" =~ ^[0-9a-f]{64}$ ]] || {
            warn "first-owner candidate is not a valid public key; refusing to act"
            return 4
        }

        if ! podman exec "$relay" buzz-admin add-member \
            --pubkey "$candidate" --role admin >/dev/null; then
            warn "Buzz rejected the local owner enrollment"
            return 5
        fi
        for _ in $(seq 1 30); do
            member_count=$(db_query "$postgres" "$member_sql" 2>/dev/null || true)
            if [[ "$member_count" =~ ^[0-9]+$ ]] && ((member_count > 0)); then
                mark_complete
                notify_complete
                return 0
            fi
            sleep 1
        done
        warn "Buzz did not persist the local owner enrollment"
        return 5
    done

    warn "timed out before a unique first local profile was available"
    return 3
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    "") ;;
    *) usage >&2; exit 2 ;;
esac

[[ "$PROJECT" =~ ^[A-Za-z0-9_.-]+$ ]] || { warn "invalid compose project"; exit 2; }
[[ "$COMMUNITY_HOST" =~ ^127\.0\.0\.1:[0-9]{1,5}$ ]] || {
    warn "only a loopback Buzz community can be bootstrapped"
    exit 2
}
[[ "$ATTEMPTS" =~ ^[1-9][0-9]*$ ]] || { warn "invalid attempt count"; exit 2; }
[[ "$INTERVAL" =~ ^[0-9]+$ ]] || { warn "invalid polling interval"; exit 2; }
(( EUID != 0 )) || { warn "run this helper as the desktop user, not root"; exit 2; }

umask 077
install -d -m 0700 "$STATE_DIR"
exec 9>"$STATE_DIR/local-owner-bootstrap.lock"
flock -n 9 || exit 0
[[ ! -e "$MARKER" ]] || exit 0
bootstrap_owner
