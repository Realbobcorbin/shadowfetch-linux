#!/bin/sh
# grub-btrfs-overlay (local-bottom) - boot a read-only Phoenix Point as a
# writable tmpfs-overlay session. Part of the in-house grub-btrfs 4.14-2
# package, Shadowfetch Linux 2.1.2 "Fire Edition". Ported from Kali's
# grub-btrfs "Unkaputtbar" packaging.
#
# Runs after the root filesystem is mounted at ${rootmnt}, before the pivot.
# If the kernel cmdline shows we were booted from a snapshot under
# @snapshots ("Last Known Good Flame" GRUB submenu entry generated by
# 41_snapshots-btrfs), the read-only snapshot becomes the lower layer of an
# overlayfs with a tmpfs upper layer: the session is fully writable, RAM
# holds the writes, and NOTHING is written to the snapshot or the real root.
# A marker is dropped at /run/phoenix-overlay (the initramfs /run is moved
# into the real system) for the session banner and for phoenix-restore,
# which is supported from inside this session and operates on the real
# volume via a fresh subvolid=5 mount.
#
# On any parse failure or mount failure the script leaves ${rootmnt} exactly
# as it found it: worst case is the stock read-only snapshot boot, never a
# broken one.

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /scripts/functions

# --- 1. Are we booting a snapshot? -----------------------------------------
# grub-btrfs entries carry rootflags=...subvol=@snapshots/<N>/snapshot...
# (with or without a leading slash). Anything else: normal boot, leave.
cmdline=$(cat /proc/cmdline 2>/dev/null) || exit 0

subvol=
for arg in $cmdline; do
    case "$arg" in
        rootflags=*)
            flags=${arg#rootflags=}
            oldifs=$IFS
            IFS=,
            for f in $flags; do
                case "$f" in
                    subvol=*) subvol=${f#subvol=} ;;
                esac
            done
            IFS=$oldifs
            ;;
    esac
done

[ -n "$subvol" ] || exit 0
# Normalise: strip a leading slash for matching.
rel=${subvol#/}
case "$rel" in
    @snapshots/*/snapshot|@snapshots/*/snapshot/*) ;;
    *) exit 0 ;;
esac

# Snapshot number = the path component after @snapshots/.
snapnum=${rel#@snapshots/}
snapnum=${snapnum%%/*}
case "$snapnum" in
    ''|*[!0-9]*) snapnum= ;;
esac

log_begin_msg "grub-btrfs-overlay: snapshot boot detected (${subvol}), building tmpfs overlay"

# --- 2. Remember the real device before we rearrange mounts ----------------
rootdev=
while read -r dev mnt fstype rest; do
    if [ "$mnt" = "$rootmnt" ] && [ "$fstype" = "btrfs" ]; then
        rootdev=$dev
    fi
done < /proc/mounts

# --- 3. Build the overlay ---------------------------------------------------
modprobe overlay 2>/dev/null || true
if ! grep -q '[[:space:]]overlay$' /proc/filesystems 2>/dev/null; then
    log_failure_msg "grub-btrfs-overlay: overlay filesystem unavailable; continuing with read-only snapshot"
    log_end_msg
    exit 0
fi

OVL=/overlay
mkdir -p "$OVL/lower" "$OVL/ram"

# Move the read-only snapshot mount aside to become the lower layer. These
# directories live in the initramfs rootfs; once the overlay is mounted the
# kernel keeps the underlying filesystems referenced through it, so the
# pivot detaching these paths later is harmless.
if ! mount -n -o move "$rootmnt" "$OVL/lower"; then
    log_failure_msg "grub-btrfs-overlay: could not move snapshot mount; continuing with read-only snapshot"
    log_end_msg
    exit 0
fi

if ! mount -n -t tmpfs -o size=50%,mode=0755 phoenix-overlay "$OVL/ram"; then
    # Roll back to the plain snapshot mount.
    mount -n -o move "$OVL/lower" "$rootmnt" || true
    log_failure_msg "grub-btrfs-overlay: tmpfs mount failed; continuing with read-only snapshot"
    log_end_msg
    exit 0
fi
mkdir -p "$OVL/ram/upper" "$OVL/ram/work"

if ! mount -n -t overlay \
        -o "lowerdir=$OVL/lower,upperdir=$OVL/ram/upper,workdir=$OVL/ram/work" \
        phoenix-overlay "$rootmnt"; then
    umount "$OVL/ram" 2>/dev/null || true
    mount -n -o move "$OVL/lower" "$rootmnt" || true
    log_failure_msg "grub-btrfs-overlay: overlay mount failed; continuing with read-only snapshot"
    log_end_msg
    exit 0
fi

# --- 4. Marker for the running system --------------------------------------
# init moves the initramfs /run into the real root, so this file surfaces as
# /run/phoenix-overlay: consumed by the Phoenix session banner and by
# phoenix-restore (preselected Point + real device, no guessing).
mkdir -p /run
{
    echo "PHOENIX_OVERLAY=1"
    echo "PHOENIX_SNAPSHOT=${snapnum}"
    echo "PHOENIX_SUBVOL=${subvol}"
    echo "PHOENIX_ROOT_DEVICE=${rootdev}"
} > /run/phoenix-overlay
chmod 0644 /run/phoenix-overlay

log_success_msg "grub-btrfs-overlay: riding Phoenix Point ${snapnum:-?} on tmpfs (writes vanish on reboot)"
log_end_msg
exit 0
