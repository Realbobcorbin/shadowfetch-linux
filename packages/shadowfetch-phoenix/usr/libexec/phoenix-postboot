#!/bin/sh
# phoenix-postboot - finish a phoenix-restore on the next boot.
# Part of Shadowfetch Linux 2.1.2 "Fire Edition".
#
# Two jobs, both cheap and idempotent, run once per boot by
# phoenix-postboot.service:
#
#   1. If /var/lib/shadowfetch/phoenix-update-grub exists (written into the
#      restored root by phoenix-restore), run update-grub so the menu's baked
#      paths match the new root, then clear the flag. On failure the flag is
#      kept for the next boot.
#
#   2. Garbage-collect restore leftovers on the volume top-level: park any
#      stray @new (interrupted restore) as @_prev_<ts>, then keep only the
#      MOST RECENT @_prev_* and delete the rest.
#
# Skipped entirely inside a "Last Known Good Flame" overlay session: never
# GC the real volume while the user is riding a Point deciding what to keep.

set -u

case "${1:-}" in
  -h|--help)
    cat <<'SFHELP'
phoenix-postboot - post-restore boot pass (run by systemd on every boot).

USAGE
  phoenix-postboot     run update-grub if flagged; GC @_prev/@new leftovers

Part of Shadowfetch Linux. https://shadowfetch.com/linux/
SFHELP
    exit 0 ;;
  --version)
    echo "phoenix-postboot (Shadowfetch Linux) $(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)"; exit 0 ;;
esac

# Overlay session or live media: do nothing.
[ -f /run/phoenix-overlay ] && exit 0
if [ -e /run/live/medium ] || [ -e /run/live/rootfs ]; then exit 0; fi

[ "$(id -u)" -eq 0 ] || { echo "phoenix-postboot: must run as root" >&2; exit 1; }
[ "$(stat -f -c %T / 2>/dev/null)" = "btrfs" ] || exit 0

FLAG=/var/lib/shadowfetch/phoenix-update-grub

# --- 1. update-grub if a restore flagged it --------------------------------
if [ -f "$FLAG" ]; then
    if command -v update-grub >/dev/null 2>&1 && update-grub >/dev/null 2>&1; then
        rm -f "$FLAG"
    else
        echo "phoenix-postboot: update-grub failed; keeping flag for next boot" >&2
    fi
fi

# --- 2. GC leftovers on the volume top-level -------------------------------
DEV=$(findmnt -n -o SOURCE / 2>/dev/null || true)
DEV=${DEV%%\[*}
[ -n "$DEV" ] && [ -b "$DEV" ] || exit 0

MNT=$(mktemp -d /run/phoenix-postboot.XXXXXX)
cleanup() {
    if mountpoint -q "$MNT" 2>/dev/null; then umount "$MNT" 2>/dev/null || true; fi
    rmdir "$MNT" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

mount -t btrfs -o subvolid=5 "$DEV" "$MNT" 2>/dev/null || exit 0

# Park a stray @new. If a restore crashed after its atomic exchange, @new is
# the previous root and deserves the same one-generation grace as any @_prev;
# if it crashed before, this parks a harmless snapshot copy that the next
# pass below will age out.
if [ -d "$MNT/@new" ]; then
    mv "$MNT/@new" "$MNT/@_prev_$(date +%Y%m%d%H%M%S)_recovered" 2>/dev/null || true
fi

# Keep only the newest @_prev_* (timestamps sort lexicographically).
newest=$(ls -d "$MNT"/@_prev_* 2>/dev/null | sort | tail -n 1)
for p in "$MNT"/@_prev_*; do
    [ -d "$p" ] || continue
    [ "$p" = "$newest" ] && continue
    btrfs subvolume delete "$p" >/dev/null 2>&1 || \
        echo "phoenix-postboot: could not delete leftover $(basename "$p")" >&2
done

exit 0
