// Shadowfetch Fireproof: APT periodic policy.
//
// Package LISTS refresh daily so the Fireproof badge and analyze screen
// stay honest without any daemon of ours touching the network. Nothing
// is ever downloaded or installed unattended: downloads happen only in
// Fireproof's labeled, post-consent download phase, and installs only
// after the NEWS gate.
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Download-Upgradeable-Packages "0";
APT::Periodic::Unattended-Upgrade "0";
APT::Periodic::AutocleanInterval "0";
